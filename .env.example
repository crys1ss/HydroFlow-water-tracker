# ================================================================
# HydroFlow Email Automation Configuration
# ================================================================
# Choose ANY of the following options to automate OTP delivery to user inboxes:

# ----------------------------------------------------------------
# OPTION 1: Resend API (Recommended for Vercel / Cloud Run / Production)
# Get a free API key (3,000 free emails/month) at: https://resend.com/api-keys
# ----------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM="HydroFlow <onboarding@resend.dev>"

# ----------------------------------------------------------------
# OPTION 2: SendGrid API
# Get an API key at: https://app.sendgrid.com/settings/api_keys
# ----------------------------------------------------------------
SENDGRID_API_KEY=""
SENDGRID_FROM="no-reply@hydroflow.app"

# ----------------------------------------------------------------
# OPTION 3: Brevo (Sendinblue) API
# Get an API key at: https://app.brevo.com/settings/keys/api
# ----------------------------------------------------------------
BREVO_API_KEY=""
BREVO_FROM="no-reply@hydroflow.app"

# ----------------------------------------------------------------
# OPTION 4: Gmail SMTP (Personal or Business Gmail)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# ----------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HydroFlow <no-reply@hydroflow.app>"
